# dependencies
# `**/` matters: Docker matches these patterns against the full relative path,
# so a bare `node_modules` only covers the root one. The workspace packages keep
# their own `node_modules` (pnpm links), and copying a host's Windows junctions
# over the image's Linux links leaves `rollup` (and everything else) pointing at
# a path that does not exist — `pnpm run build:packages` then dies with
# "Cannot find module '/app/packages/mathml2omml/node_modules/rollup/...'".
**/node_modules
**/.pnpm-store

# build output
.next
out
build
dist

# git
.git
.gitignore

# IDE
.idea
.vscode

# env & secrets
.env*
!.env.example
server-providers*.yml
# model configuration: may hold inline keys; mounted at run time, never baked in
openmaic.yml

# misc
assets
*.md
*.pdf
*.pem
.DS_Store
.vercel
coverage
logs
data
docs
.claude

# isolated MP4 render service — built as its own image (render-service/Dockerfile),
# never part of the main app image.
render-service

# Local-only workspace: agent memory, private docs, delivery fixtures and the
# Aliyun Drive login token. None of it belongs in an image, and `COPY . .` would
# otherwise bake it in.
.workbuddy
